# -----------------------------------------------------------------------------
# Machine specific settings for the Proxmox seminar lab.
# Copy this file to .env and adjust. .env is git-ignored and holds the
# generated credentials after provisioning.
#
# Precedence: environment variable > .env > config/default.env
# -----------------------------------------------------------------------------

# --- AWS ---------------------------------------------------------------------
AWS_REGION="eu-central-1"
# AWS_PROFILE=""                      # use a named profile instead of the ambient credentials
# AWS_CALLER_IP="203.0.113.10"        # your public IP; SSH and the web UI are only open to it

# --- Sizing ------------------------------------------------------------------
# Must support nested virtualization (m8i/c8i/r8i, m7i/c7i/r7i, i7i or *.metal).
# PVE_INSTANCE_TYPE="m8i.4xlarge"
# PVE_NODE_NAMES="pve1 pve2 pve3"
# PVE_CLUSTER_NAME="prod-cluster"
# NFS_INSTANCE_TYPE="t3.medium"
# PBS_INSTANCE_TYPE="t3.large"

# --- Volumes -----------------------------------------------------------------
# PVE_ROOT_VOLUME_SIZE="32"           # GiB - operating system
# PVE_DATA_VOLUME_SIZE="250"          # GiB - the local-lvm thin pool
# NFS_VOLUME_SIZE="100"               # GiB - the shared storage
# PBS_VOLUME_SIZE="200"               # GiB - the backup datastore

# --- Guest inventory ---------------------------------------------------------
# One template per node and one running guest per node. The templates live
# on the node-local local-lvm, and each guest is a full clone of the
# template of the node it runs on. See config/default.env for the full set.
# VM_TEMPLATE_ID="9101"
# VM_TEMPLATE_ID_2="9102"
# VM_TEMPLATE_ID_3="9103"
# VM_WEB_ID="9201"
# VM_CLONE_FULL_ID="9202"
# VM_CLONE_LINKED_ID="9203"
# CT_APP_ID="300"

# --- Credentials -------------------------------------------------------------
# Leave empty to have provision.sh generate them.
# PVE_ROOT_PASSWORD=""
# PBS_PASSWORD=""

# --- Debugging ---------------------------------------------------------------
# LAB_DEBUG=1                          # verbose logging from the harness
# NO_COLOR=1                           # plain output, no ANSI colours
