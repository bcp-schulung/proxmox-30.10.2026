# =============================================================================
# Proxmox VE Advanced Seminar Lab - Default Configuration
# =============================================================================
# Every value here can be overridden by a .env file in the repository root
# (git-ignored) or by a real environment variable. Precedence:
#     environment variable  >  .env  >  config/default.env
#
# Do not edit this file for machine-specific settings - use .env instead.
# Copy .env.example to .env and adjust.
# =============================================================================

# --- AWS ---------------------------------------------------------------------
AWS_REGION="eu-central-1"
AWS_PROFILE=""                       # leave empty to use the ambient credentials
AWS_CALLER_IP=""                     # auto-detected when empty (public IP for web UI)

# --- Network topology --------------------------------------------------------
# VPC CIDR and the three subnets. The guest overlay (GUEST_SUBNET_CIDR) lives
# entirely inside Proxmox on the vmbr0 bridge and is NATed out by the node.
VPC_CIDR="10.20.0.0/16"
VPC_GATEWAY="10.20.0.1"                # AWS default gateway for the VPC
SUBNET_PUBLIC_CIDR="10.20.0.0/24"    # PVE nodes: management, cluster and web UI
SUBNET_SERVICES_CIDR="10.20.2.0/24"  # NFS + Proxmox Backup Server instances
VPC_DNS_HOSTNAMES_ENABLED="yes"

# Guest overlay network. This is the subnet the seminar decks use (10.10.10.0/24).
GUEST_SUBNET_CIDR="10.10.10.0/24"
GUEST_GATEWAY="10.10.10.1"
GUEST_DHCP_START="10.10.10.100"
GUEST_DHCP_END="10.10.10.200"
GUEST_DHCP_LEASE_TIME="12h"

# --- Proxmox cluster ---------------------------------------------------------
PVE_CLUSTER_NAME="prod-cluster"
PVE_NODE_NAMES="pve1 pve2 pve3"
PVE_DOMAIN="example.com"             # pve1.example.com, pve1.lab.example.com ...
PVE_ROOT_PASSWORD=""                  # auto-generated when empty
PVE_KEYPAIR_NAME="pve-lab"
PVE_SSH_KEY_PATH=""                   # defaults to .state/keys/<keypair>.pem

# --- EC2 sizing --------------------------------------------------------------
# Nested virtualization is REQUIRED to run KVM guests inside Proxmox.
# Supported families: m7i/m8i, c7i/c8i, r7i/r8i, i7i (8th-gen Intel) or *.metal.
PVE_INSTANCE_TYPE="m8i.4xlarge"
PVE_ROOT_VOLUME_SIZE="32"            # GiB - OS + Proxmox
PVE_DATA_VOLUME_SIZE="250"           # GiB - LVM-thin pool (local-lvm)
NFS_INSTANCE_TYPE="t3.medium"
NFS_VOLUME_SIZE="100"                # GiB - exported NFS storage
PBS_INSTANCE_TYPE="t3.large"
PBS_VOLUME_SIZE="200"                # GiB - Proxmox Backup Server datastore

# --- AMI build ---------------------------------------------------------------
PVE_AMI_NAME="pve-lab-amd64-v3"
PBS_AMI_NAME="pbs-lab-amd64-v3"
NFS_AMI_NAME="nfs-lab-amd64-v3"
PACKER_AMI_REGION=""                  # defaults to AWS_REGION
DEBIAN_OWNER_ID="136693071363"       # official Debian cloud images

# --- Storage -----------------------------------------------------------------
NFS_EXPORT="/export/lab"
NFS_STORAGE_ID="nfs-lab"
PBS_STORAGE_ID="pbs-main"
PBS_DATASTORE="main"
PBS_USERNAME="backup@pbs"
PBS_PASSWORD=""                       # auto-generated when empty
LOCAL_STORAGE_ID="local-lvm"
LOCAL_VG_NAME="pve"
LOCAL_THINPOOL_NAME="data"

# --- Guest inventory ---------------------------------------------------------
# There is ONE template PER NODE, and one running guest PER NODE.
#
#   pve1: template 9101 debian13-tpl-pve1  ->  running 9201 debian13-run-pve1
#   pve2: template 9102 debian13-tpl-pve2  ->  running 9202 debian13-run-pve2
#   pve3: template 9103 debian13-tpl-pve3  ->  running 9203 debian13-run-pve3
#
# CT  300 app01    : unprivileged LXC from the Debian 13 standard template
# CT  301 db01     : second LXC for the container-vs-VM exercise
#
# Why one template per node instead of one shared template:
#
#   A full clone can be moved to another node only when the source is on
#   shared storage. A template on the local storage of a node is refused
#   with "can't clone VM to node 'pve2' (VM uses local storage)".
#
#   A linked clone is a snapshot of the template's disk, and a snapshot is
#   only possible on a storage that supports them. NFS does not:
#   "Linked clone feature is not supported for 'nfs-lab:9000/...'".
#
# A template on the node's own local LVM-thin storage satisfies both
# constraints: it can be cloned onto that node (no move across nodes) and
# it supports snapshots (a block storage, not NFS). Every node therefore
# carries its own copy of the golden image, and every guest is cloned from
# the template of the node it runs on.
#
# The guest image is a qcow2 DISK, not an ISO. The 'iso/' subdirectory of a
# directory storage only accepts real ISO extensions, so
# 'local:iso/debian-13-generic-amd64.qcow2' is rejected by the volume-name
# parser ("unable to parse directory volume name"). The image is brought in
# with 'qm importdisk', which takes a plain path.
#
# The disk number that 'qm importdisk' picks is NOT the one to assume: with
# an 'efidisk0' already attached, the EFI vars volume takes disk-0 and the
# imported OS disk lands on disk-1. Attaching disk-0 to scsi0 produces a
# template that boots a 4 MB EFI partition instead of Debian. Read the
# volume name back out of 'qm config' and verify the size before templating.
#
# NOTE: the Debian cloud image ships NO network configuration and NO root
# password of its own - everything is meant to arrive from a cloud-init
# data source. A template without a cloud-init drive boots to a login
# prompt with no network interface at all.
VM_TEMPLATE_ID="9101"
VM_TEMPLATE_NAME="debian13-tpl-pve1"
VM_TEMPLATE_ID_2="9102"
VM_TEMPLATE_NAME_2="debian13-tpl-pve2"
VM_TEMPLATE_ID_3="9103"
VM_TEMPLATE_NAME_3="debian13-tpl-pve3"
VM_WEB_ID="9201"
VM_WEB_NAME="debian13-run-pve1"
VM_CLONE_FULL_ID="9202"
VM_CLONE_FULL_NAME="debian13-run-pve2"
VM_CLONE_LINKED_ID="9203"
VM_CLONE_LINKED_NAME="debian13-run-pve3"
CT_APP_ID="300"
CT_APP_NAME="app01"
CT_DB_ID="301"
CT_DB_NAME="db01"

# The Debian 13 cloud image.
#
# NOTE: the 'genericcloud' variant is NOT published under
# images/cloud/trixie/latest - only 'generic' is. The URL below points at
# the image that actually exists. The SHA512 of the file is checked against
# the upstream SHA512SUMS before it is used.
GUEST_OS_URL="https://cloud.debian.org/images/cloud/trixie/latest/debian-13-generic-amd64.qcow2"
GUEST_OS_NAME="debian-13"
GUEST_OS_CLOUDINIT_USER="root"
GUEST_MEM_MB="2048"
GUEST_CORES="2"
GUEST_DISK_GB="16"
CT_MEM_MB="512"
CT_CORES="1"
CT_DISK_GB="8"

# --- Security lab (optional, --with-security) --------------------------------
SEC_REALM="ad-corp"
SEC_USER="jsmith@ad-corp"
SEC_ROLE="VM-Operator"
SEC_ROLE_PRIVS="VM.Console,VM.PowerMgmt,VM.Monitor"
SEC_TOKEN_USER="automation@pve"
SEC_TOKEN_NAME="terraform"
SEC_TOKEN_PATH="/vms/100"
SEC_SDN_VNET="mgmtnet"
SEC_SDN_ZONE="mgmt-zone"

# --- Behaviour ---------------------------------------------------------------
SSH_KEY_BITS="4096"
SSH_CONNECT_TIMEOUT="15"
SSH_RETRIES="40"
BOOT_TIMEOUT="900"                  # seconds to wait for a node to come back up
STATE_VERSION="1"
